# Required: Postgres connection string (Vercel + Neon sets this automatically)
DATABASE_URL=

# Optional overrides for the demo workspace (used only when the database is first created)
# DEMO_USERNAME=demo@paidup.app
# DEMO_PASSWORD=paidup-demo
# DEMO_BUSINESS_NAME=Ananya Rao Design Studio
# DEMO_OWNER_NAME=Ananya Rao
# DEMO_UPI_ID=ananyarao.demo@upi
# MCP_KEY=            # fixed connector key; random if unset
# SESSION_SECRET=     # cookie signing secret; derived from DATABASE_URL if unset
# APP_URL=            # public base URL; detected from the request if unset
